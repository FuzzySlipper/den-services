{
  "version": "1.0.0",
  "tools": [
    {
      "id": "board.search",
      "description": "Search visible Board posts and comments in one project without adding Board search to MCP.",
      "tags": ["board", "search", "conversation", "read"],
      "repo": "den-services",
      "root": "/home/dev/den-services",
      "working_directory": "/home/dev/den-services",
      "argv": ["den-tool", "board", "search"],
      "risk": "read",
      "source": "cmd/den-tool board search",
      "requirements": ["den-tool installed on PATH", "Board service reachable through DEN_BOARD_URL or the loopback default"],
      "examples": ["den-tool board search --project den-services --query threading", "den-tool run board.search -- --project den-services --query threading --json"]
    },
    {
