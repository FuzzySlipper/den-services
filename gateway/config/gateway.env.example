# Gateway secrets and env-only settings.
# Copy to /etc/den-services/gateway.env on den-srv and set a real token.

GATEWAY_CONFIG_PATH=/data/services/gateway/config/config.yaml
DEN_GATEWAY_SERVICE_TOKEN=replace-with-service-token
DEN_GATEWAY_WEB_TOKEN=replace-with-web-edge-caller-token
DEN_GATEWAY_PROJECTS_UPSTREAM_TOKEN=replace-with-projects-service-token
DEN_GATEWAY_TASKS_UPSTREAM_TOKEN=replace-with-tasks-service-token
DEN_GATEWAY_MESSAGES_UPSTREAM_TOKEN=replace-with-messages-service-token
DEN_GATEWAY_DOCUMENTS_UPSTREAM_TOKEN=replace-with-documents-service-token
DEN_GATEWAY_KNOWLEDGE_UPSTREAM_TOKEN=replace-with-knowledge-service-token
DEN_GATEWAY_HANDOFF_UPSTREAM_TOKEN=replace-with-handoff-service-token
DEN_GATEWAY_BOARD_UPSTREAM_TOKEN=replace-with-board-service-token
DEN_GATEWAY_GUIDANCE_UPSTREAM_TOKEN=replace-with-guidance-service-token
DEN_GATEWAY_REVIEW_UPSTREAM_TOKEN=replace-with-review-service-token
DEN_GATEWAY_ARTIFACTS_UPSTREAM_TOKEN=replace-with-artifacts-service-token
DEN_GATEWAY_VISUAL_CONTRACT_UPSTREAM_TOKEN=replace-with-visual-contract-service-token
DEN_GATEWAY_LIBRARIAN_UPSTREAM_TOKEN=replace-with-librarian-service-token
DEN_GATEWAY_DELIVERY_UPSTREAM_TOKEN=replace-with-delivery-service-token
DEN_GATEWAY_DELIVERY_WRITE_TOKEN=replace-with-delivery-browser-caller-token
DEN_GATEWAY_OBSERVATION_UPSTREAM_TOKEN=replace-with-observation-service-token
DEN_GATEWAY_OBSERVATION_READ_TOKEN=replace-with-observation-read-token
DEN_GATEWAY_OBSERVATION_WRITE_TOKEN=replace-with-observation-write-token
DEN_GATEWAY_CONVERSATION_UPSTREAM_TOKEN=replace-with-conversation-service-token
DEN_GATEWAY_CONVERSATION_READ_TOKEN=replace-with-conversation-read-canary-token
DEN_GATEWAY_CONVERSATION_WRITE_TOKEN=replace-with-conversation-write-canary-token
DEN_GATEWAY_TIMELINE_UPSTREAM_TOKEN=replace-with-timeline-service-token
DEN_GATEWAY_TIMELINE_READ_TOKEN=replace-with-timeline-read-token
DEN_GATEWAY_DOC_PUBLISH_UPSTREAM_TOKEN=replace-with-doc-publish-service-token
DEN_GATEWAY_DOC_PUBLISH_CALLER_TOKEN=replace-with-doc-publish-caller-token
DEN_GATEWAY_RUNTIME_UPSTREAM_TOKEN=replace-with-runtime-service-token
DEN_GATEWAY_RUNTIME_CALLER_TOKEN=replace-with-runtime-adapter-token
